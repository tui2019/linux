config SPECTRA_CAMERA
	tristate "Qualcomm Spectra Camera (CamX camera_kt) driver"
	depends on ARCH_QCOM && MEDIA_SUPPORT && VIDEO_DEV && MEDIA_CONTROLLER && VIDEO_V4L2_SUBDEV_API
	select SPECTRA_KT
	select SPECTRA_ISP
	select SPECTRA_ICP
	select SPECTRA_JPEG
	select SPECTRA_LRME
	select SPECTRA_SENSOR
	select SPECTRA_SENSOR_SYSFS_UTIL
	select ENABLE_US_API
	help
	  Qualcomm Spectra Camera (CamX camera_kt) subsystem driver from
	  qualcomm-linux/camera-driver, integrated in-tree for SM7125 (atoll)
	  on Linux 7.3.

