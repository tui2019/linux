# Samsung Galaxy Tab S6 Lite (2022) Wi-Fi (SM-P613 / gta4xlvewifi)
# Config fragment for Android 18 / Linux 7.3 (applied on top of defconfig + sm7125.config)

CONFIG_LOCALVERSION="-sm7125-p613"
# CONFIG_LOCALVERSION_AUTO is not set

# Avoid Rust/CFI toolchain requirements for non-GKI device bringup
# CONFIG_RUST is not set
# CONFIG_CFI is not set

# P613 Display & Bias Regulator (BOE TV104WUM HX83102E + ISL98608)
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_HIMAX_HX83102=y
CONFIG_REGULATOR_ISL98608=y
CONFIG_REGULATOR_QCOM_REFGEN=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# CAF KGSL (/dev/kgsl-3d0) for Adreno A618 (qualcomm-linux/kgsl upstream mode)
CONFIG_QCOM_KGSL=y
CONFIG_QCOM_KGSL_UPSTREAM=y
# CONFIG_QCOM_KGSL_CORESIGHT is not set
CONFIG_QCOM_ADRENO_DEFAULT_GOVERNOR="simple_ondemand"
CONFIG_QCOM_KGSL_IOCOHERENCY_DEFAULT=y
CONFIG_QCOM_KGSL_SORT_POOL=y
CONFIG_QCOM_KGSL_CONTEXT_DEBUG=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_TRACE_GPU_MEM=y

# CAF Spectra CamX Camera (qualcomm-linux/camera-driver camera_kt)
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_SPECTRA_CAMERA=y
# CONFIG_VIDEO_QCOM_CAMSS is not set

# P613 Power / Charger / Fuel Gauge (Silicon Mitus SM5714)
CONFIG_FUEL_GAUGE_SM5714=y
CONFIG_CHARGER_SM5714=y

# P613 Audio (QDSP6 + WCD9380 + SoundWire + TAS2562 dual speaker amps — built-in)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_COMPRESS_OFFLOAD=y
CONFIG_SND_HWDEP=y
CONFIG_SND_RAWMIDI=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_USB_AUDIO_QMI=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_USB=y
CONFIG_SND_SOC_QDSP6_USB=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_REGMAP_SOUNDWIRE=y
CONFIG_PINCTRL_LPASS_LPI=y
CONFIG_PINCTRL_SC7280_LPASS_LPI=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QCOM_COMMON=y
CONFIG_SND_SOC_QCOM_SDW=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_QDSP6_COMMON=y
CONFIG_SND_SOC_QDSP6_CORE=y
CONFIG_SND_SOC_QDSP6_AFE=y
CONFIG_SND_SOC_QDSP6_AFE_DAI=y
CONFIG_SND_SOC_QDSP6_AFE_CLOCKS=y
CONFIG_SND_SOC_QDSP6_ADM=y
CONFIG_SND_SOC_QDSP6_ROUTING=y
CONFIG_SND_SOC_QDSP6_ASM=y
CONFIG_SND_SOC_QDSP6_ASM_DAI=y
CONFIG_SND_SOC_QDSP6_APM=y
CONFIG_SND_SOC_QDSP6_APM_DAI=y
CONFIG_SND_SOC_QDSP6_APM_LPASS_DAI=y
CONFIG_SND_SOC_QDSP6_PRM=y
CONFIG_SND_SOC_QDSP6_PRM_LPASS_CLOCKS=y
CONFIG_SND_SOC_SM8250=y
CONFIG_SND_SOC_TAS2562=y
CONFIG_SND_SOC_WCD_COMMON=y
CONFIG_SND_SOC_WCD_CLASSH=y
CONFIG_SND_SOC_WCD_MBHC=y
CONFIG_SND_SOC_WCD938X=y
CONFIG_SND_SOC_WCD938X_SDW=y
CONFIG_SND_SOC_LPASS_MACRO_COMMON=y
CONFIG_SND_SOC_LPASS_RX_MACRO=y
CONFIG_SND_SOC_LPASS_TX_MACRO=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
CONFIG_SND_SOC_LPASS_WSA_MACRO=y
CONFIG_SND_SOC_DMIC=y
CONFIG_SND_SOC_BT_SCO=y

# P613 Core SoC / Remoteproc / Connectivity / Storage / Input (built-in)
CONFIG_FW_LOADER_USER_HELPER=y
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_CTRL=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_SPM=y
CONFIG_QCOM_IPA=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_TZMEM=y
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_RESET_QCOM_PDC=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_LMH=y
CONFIG_NVMEM_QCOM_SEC_QFPROM=y
CONFIG_HW_RANDOM_QCOM=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_TUN=y
CONFIG_QCOM_FASTRPC=y
CONFIG_ATH_COMMON=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_QCA=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INPUT_PM8XXX_VIBRATOR=y
CONFIG_INPUT_UINPUT=y
CONFIG_TOUCHSCREEN_HIMAX_HX83102_SPI=y

# Official KernelSU (built-in, tiann/KernelSU main with Linux 7.3+ support)
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_HEADERS_INSTALL=y
CONFIG_KSU=y

# Android Core (AOSP android-base.config equivalents on C binder/ashmem)
CONFIG_BOOT_CONFIG=y
CONFIG_BOOT_CONFIG_FORCE=y
CONFIG_BOOT_CONFIG_EMBED=y
CONFIG_BOOT_CONFIG_EMBED_FILE="arch/arm64/configs/p613.bootconfig"
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=y
CONFIG_ANDROID_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_USB_CONFIGFS_F_UVC=y

# Memory / Process / DMA-BUF / Cgroups
CONFIG_PSI=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FAVOR_DYNMODS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_CPUSETS_V1=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOPRIO=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_BPF=y
CONFIG_USERFAULTFD=y
CONFIG_ANON_VMA_NAME=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_UID_SYS_STATS=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_UDMABUF=y
CONFIG_MEMFD_CREATE=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_WRITEBACK=y

# Android Filesystems, Encryption, and Device-Mapper
CONFIG_BLK_DEV_DM=y
CONFIG_DM_UEVENT=y
CONFIG_DM_BOW=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_DM_CRYPT=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_USER=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_FS_VERITY=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_ADIANTUM=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_XCBC=y
CONFIG_CRYPTO_HCTR2=y
CONFIG_CRYPTO_BLAKE2B=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_DES=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_UNFAIR_RWSEM=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EROFS_FS=y
CONFIG_FUSE_FS=y
CONFIG_FUSE_BPF=y
CONFIG_OVERLAY_FS=y
CONFIG_INCREMENTAL_FS=y

# Android Security & Networking
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_SAFESETID=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
