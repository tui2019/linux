				hw-tbuf = <227>;
				hw-scl-stretch-en = <0>;
				hw-trdhld = <6>;
				hw-tsp = <3>;
				cci-clk-src = <37500000>;
				status = "okay";
			};

			qcom,i2c_fast_mode {
				hw-thigh = <38>;
				hw-tlow = <56>;
				hw-tsu-sto = <40>;
