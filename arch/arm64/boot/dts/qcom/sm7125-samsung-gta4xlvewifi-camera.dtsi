// SPDX-License-Identifier: GPL-2.0
/*
 * Qualcomm Spectra CamX (camera_kt) Device Tree for
 * Samsung Galaxy Tab S6 Lite (2022) Wi-Fi (SM-P613 / gta4xlvewifi, SM7125 / atoll).
 *
 * Sensors:
 *   - Rear  (slot 0): Samsung S5K4HA (8MP, CCI0 Master 0, 0x5A, CSIPHY0)
 *                     + AF actuator (i2c9 @ 0x0C) + EEPROM (i2c9 @ 0x58)
 *   - Front (slot 1 & 8): GalaxyCore GC5035 (5MP, CCI0 Master 1, 0x6E, CSIPHY2)
 *                     + OTP EEPROM (CCI0 Master 1 @ 0x59)
 */

#include <dt-bindings/camera/msm-camera.h>
#include <dt-bindings/clock/qcom,camcc-sc7180.h>
#include <dt-bindings/clock/qcom,gcc-sc7180.h>
#include <dt-bindings/interconnect/qcom,sc7180.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

&tlmm {
	cci0_active: cci0-active-state {
		pins = "gpio17", "gpio18";
		function = "cci_i2c";
		drive-strength = <2>;
		bias-pull-up;
	};

	cci0_suspend: cci0-suspend-state {
		pins = "gpio17", "gpio18";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	cci1_active: cci1-active-state {
		pins = "gpio19", "gpio20";
		function = "cci_i2c";
		drive-strength = <2>;
		bias-pull-up;
	};

	cci1_suspend: cci1-suspend-state {
		pins = "gpio19", "gpio20";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	cci2_active: cci2-active-state {
		pins = "gpio27", "gpio28";
		function = "cci_i2c";
		drive-strength = <2>;
		bias-pull-up;
	};

	cci2_suspend: cci2-suspend-state {
		pins = "gpio27", "gpio28";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	rcam_sensor_mclk_active: rcam-sensor-mclk-active-state {
		pins = "gpio13";
		function = "cam_mclk";
		drive-strength = <4>;
		bias-disable;
	};

	rcam_sensor_mclk_suspend: rcam-sensor-mclk-suspend-state {
		pins = "gpio13";
		function = "cam_mclk";
		drive-strength = <4>;
		bias-pull-down;
		output-low;
	};

	fcam_sensor_mclk_active: fcam-sensor-mclk-active-state {
		pins = "gpio23";
		function = "cam_mclk";
		drive-strength = <4>;
		bias-disable;
	};

	fcam_sensor_mclk_suspend: fcam-sensor-mclk-suspend-state {
		pins = "gpio23";
		function = "cam_mclk";
		drive-strength = <4>;
		bias-pull-down;
		output-low;
	};

	rcam_sensor_reset_active: rcam-sensor-reset-active-state {
		pins = "gpio24";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	rcam_sensor_reset_suspend: rcam-sensor-reset-suspend-state {
		pins = "gpio24";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	fcam_sensor_reset_active: fcam-sensor-reset-active-state {
		pins = "gpio21";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	fcam_sensor_reset_suspend: fcam-sensor-reset-suspend-state {
		pins = "gpio21";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	rcam_sensor_vana_active: rcam-sensor-vana-active-state {
		pins = "gpio22";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	rcam_sensor_vana_suspend: rcam-sensor-vana-suspend-state {
		pins = "gpio22";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	fcam_sensor_vana_active: fcam-sensor-vana-active-state {
		pins = "gpio63";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	fcam_sensor_vana_suspend: fcam-sensor-vana-suspend-state {
		pins = "gpio63";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	rcam_sensor_vdig_active: rcam-sensor-vdig-active-state {
		pins = "gpio10";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	rcam_sensor_vdig_suspend: rcam-sensor-vdig-suspend-state {
		pins = "gpio10";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	fcam_sensor_vdig_active: fcam-sensor-vdig-active-state {
		pins = "gpio14";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	fcam_sensor_vdig_suspend: fcam-sensor-vdig-suspend-state {
		pins = "gpio14";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};
};

&i2c9 {
	clock-frequency = <400000>;
	status = "okay";

	actuator_rear0: actuator@c {
		cell-index = <0>;
		reg = <0x0c>;
		slave-addr = <0x18>;
		compatible = "i2c_actuator";

		rgltr-cntrl-support;
		cam_vaf-supply = <&vreg_l5a_2p7>;
		regulator-names = "cam_vaf";
		rgltr-min-voltage = <2800000>;
		rgltr-max-voltage = <2800000>;
		rgltr-load-current = <200000>;
	};

	eeprom_rear0: eeprom@58 {
		cell-index = <0>;
		reg = <0x58>;
		slave-addr = <0xb0>;
		compatible = "qcom,eeprom";
		i2c-freq-mode = <1>;
		sub-type = <2>;

		cam_vio-supply = <&vreg_l18a_3p0>;
		cam_vaf-supply = <&vreg_l5a_2p7>;
		regulator-names = "cam_vio", "cam_vaf", "cam_vana", "cam_vdig";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 2800000 0 0>;
		rgltr-max-voltage = <1800000 2800000 0 0>;
		rgltr-load-current = <200000 200000 0 0>;
		power-domains = <&camcc TITAN_TOP_GDSC>;

		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&rcam_sensor_mclk_active &rcam_sensor_reset_active
			     &rcam_sensor_vana_active &rcam_sensor_vdig_active>;
		pinctrl-1 = <&rcam_sensor_mclk_suspend &rcam_sensor_reset_suspend
			     &rcam_sensor_vana_suspend &rcam_sensor_vdig_suspend>;
		gpios = <&tlmm 13 0>,
			<&tlmm 24 0>,
			<&tlmm 22 0>,
			<&tlmm 10 0>;
		gpio-reset = <1>;
		gpio-vana = <2>;
		gpio-vdig = <3>;
		gpio-req-tbl-num = <0 1 2 3>;
		gpio-req-tbl-flags = <1 0 0 0>;
		gpio-req-tbl-label = "CAMIF_MCLK0", "CAM_RESET0",
				     "CAM_VANA", "CAM_VDIG";
	};
};

&soc {
	camera_kt: camera-kt {
		compatible = "qcom,camera_kt";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0 0 0 0xffffffff>;
		status = "okay";

		cam_smmu: qcom,cam_smmu {
			compatible = "qcom,msm-cam-smmu", "simple-bus";
			status = "okay";

			msm_cam_smmu_ife {
				compatible = "qcom,msm-cam-smmu-cb";
				iommus = <&apps_smmu 0x820 0x0>,
					 <&apps_smmu 0x840 0x0>,
					 <&apps_smmu 0x860 0x0>;
				cam-smmu-label = "ife";
				iova-mem-map {
					iova-mem-region-io {
						iova-region-name = "io";
						iova-region-start = <0x7400000>;
						iova-region-len = <0xd8c00000>;
						iova-region-id = <0x3>;
						status = "okay";
					};
				};
			};

			msm_cam_smmu_lrme {
				compatible = "qcom,msm-cam-smmu-cb";
				iommus = <&apps_smmu 0x0cc0 0x0>,
					 <&apps_smmu 0x0d40 0x0>;
				cam-smmu-label = "lrme";
				iova-mem-map {
					iova-mem-region-shared {
						iova-region-name = "shared";
						iova-region-start = <0x7400000>;
						iova-region-len = <0x6400000>;
						iova-region-id = <0x1>;
						status = "okay";
					};
					iova-mem-region-io {
						iova-region-name = "io";
						iova-region-start = <0xd800000>;
						iova-region-len = <0xd2800000>;
						iova-region-id = <0x3>;
						status = "okay";
					};
				};
			};

			msm_cam_smmu_jpeg {
				compatible = "qcom,msm-cam-smmu-cb";
				iommus = <&apps_smmu 0xd80 0x20>,
					 <&apps_smmu 0xda0 0x20>;
				cam-smmu-label = "jpeg";
				iova-mem-map {
					iova-mem-region-io {
						iova-region-name = "io";
						iova-region-start = <0x7400000>;
						iova-region-len = <0xd8c00000>;
						iova-region-id = <0x3>;
						status = "okay";
					};
				};
			};

			msm_cam_icp_fw {
				compatible = "qcom,msm-cam-smmu-fw-dev";
				cam-smmu-label = "icp";
				memory-region = <&camera_region>;
			};

			msm_cam_smmu_icp {
				compatible = "qcom,msm-cam-smmu-cb";
				iommus = <&apps_smmu 0x0ce2 0x0>,
					 <&apps_smmu 0x0c80 0x0>,
					 <&apps_smmu 0x0ca0 0x0>,
					 <&apps_smmu 0x0d00 0x0>,
					 <&apps_smmu 0x0d20 0x0>;
				cam-smmu-label = "icp";
				iova-mem-map {
					iova-mem-region-firmware {
						iova-region-name = "firmware";
						iova-region-start = <0x0>;
						iova-region-len = <0x500000>;
						iova-region-id = <0x0>;
						status = "okay";
					};

					iova-mem-region-shared {
						iova-region-name = "shared";
						iova-region-start = <0x7400000>;
						iova-region-len = <0x9600000>;
						iova-region-id = <0x1>;
						status = "okay";
					};

					iova-mem-region-secondary-heap {
						iova-region-name = "secheap";
						iova-region-start = <0x10a00000>;
						iova-region-len = <0x100000>;
						iova-region-id = <0x4>;
						status = "okay";
					};

					iova-mem-region-io {
						iova-region-name = "io";
						iova-region-start = <0x10c00000>;
						iova-region-len = <0xcf300000>;
						iova-region-id = <0x3>;
						status = "okay";
					};

					iova-mem-qdss-region {
						iova-region-name = "qdss";
						iova-region-start = <0x10b00000>;
						iova-region-len = <0x100000>;
						iova-region-id = <0x5>;
						qdss-phy-addr = <0x16790000>;
						status = "okay";
					};
				};
			};

			msm_cam_smmu_cpas_cdm {
				compatible = "qcom,msm-cam-smmu-cb";
				iommus = <&apps_smmu 0x0d60 0x0>,
					 <&apps_smmu 0x0d61 0x0>;
				cam-smmu-label = "cpas-cdm";
				iova-mem-map {
					iova-mem-region-io {
						iova-region-name = "io";
						iova-region-start = <0x7400000>;
						iova-region-len = <0xd8c00000>;
						iova-region-id = <0x3>;
						status = "okay";
					};
				};
			};

			msm_cam_smmu_secure {
				compatible = "qcom,msm-cam-smmu-cb";
				cam-smmu-label = "cam-secure";
				qcom,secure-cb;
			};
		};

		cam_sync: qcom,cam-sync {
			compatible = "qcom,cam-sync";
			status = "okay";
		};

		cam_res_mgr: qcom,cam-res-mgr {
			compatible = "qcom,cam-res-mgr";
			status = "okay";
		};

		cam_cpas: qcom,cam-cpas@ac40000 {
			cell-index = <0>;
			compatible = "qcom,cam-cpas";
			label = "cpas";
			arch-compat = "cpas_top";
			status = "okay";
			reg-names = "cam_cpas_top", "cam_camnoc";
			reg = <0x0ac40000 0x1000>,
			      <0x0ac42000 0x5000>;
			reg-cam-base = <0x40000 0x42000>;
			interrupt-names = "cpas_camnoc";
			interrupts = <GIC_SPI 459 IRQ_TYPE_EDGE_RISING>;
			qcom,cpas-hw-ver = <0x150110>;
			camnoc-axi-min-ib-bw = <3000000000>;
			power-domains = <&camcc TITAN_TOP_GDSC>;
			clock-names = "gcc_ahb_clk",
				      "gcc_axi_clk",
				      "soc_ahb_clk",
				      "slow_ahb_clk_src",
				      "cpas_ahb_clk",
				      "camnoc_axi_clk";
			clocks = <&gcc GCC_CAMERA_AHB_CLK>,
				 <&gcc GCC_CAMERA_HF_AXI_CLK>,
				 <&camcc CAM_CC_SOC_AHB_CLK>,
				 <&camcc CAM_CC_SLOW_AHB_CLK_SRC>,
				 <&camcc CAM_CC_CPAS_AHB_CLK>,
				 <&camcc CAM_CC_CAMNOC_AXI_CLK>;
			src-clock-name = "slow_ahb_clk_src";
			clock-rates = <0 0 0 0 0 0>,
				      <0 0 0 80000000 0 0>,
				      <0 0 0 80000000 0 0>,
				      <0 0 0 80000000 0 0>,
				      <0 0 0 80000000 0 0>,
				      <0 0 0 80000000 0 0>;
			clock-cntl-level = "suspend", "lowsvs", "svs",
					   "svs_l1", "nominal", "turbo";
			interconnects =
				<&gem_noc MASTER_APPSS_PROC 0 &config_noc SLAVE_CAMERA_CFG 0>,
				<&mmss_noc MASTER_CAMNOC_HF0 0 &mc_virt SLAVE_EBI1 0>,
				<&mmss_noc MASTER_CAMNOC_HF1 0 &mc_virt SLAVE_EBI1 0>,
				<&mmss_noc MASTER_CAMNOC_SF 0 &mc_virt SLAVE_EBI1 0>;
			interconnect-names = "cam_ahb",
					     "cam_hf_0_mnoc",
					     "cam_hf_1_mnoc",
					     "cam_sf_0_mnoc";
			cam-ahb-num-cases = <6>;
			cam-ahb-bw-KBps = <0 0>,
					  <0 89500>,
					  <0 125000>,
					  <0 125000>,
					  <0 250000>,
					  <0 250000>;
			client-id-based;
			camnoc-bus-width = <16>;
			camnoc-axi-clk-bw-margin-perc = <10>;
			client-names =
				"csiphy0", "csiphy1", "csiphy2", "csiphy3",
				"csid0", "csid1", "csid2", "cci0", "cci1",
				"ife0", "ife1", "ife2", "ipe0",
				"ipe1", "cam-cdm-intf0", "cpas-cdm0", "bps0",
				"icp0", "jpeg-dma0", "jpeg-enc0", "lrmecpas0";

			camera-bus-nodes {
				level-0 {
					level-index = <0>;
					camnoc-max-needed;

					cam_mnoc_hf0: mnoc-hf0 {
						cell-index = <0>;
						node-name = "cam_hf_0_mnoc";
						bus-width-factor = <1>;
						traffic-merge-type = <CAM_CPAS_TRAFFIC_MERGE_SUM>;
						ib-bw-voting-needed;
						qcom,axi-port-mnoc {
							interconnects = <&mmss_noc MASTER_CAMNOC_HF0 0 &mc_virt SLAVE_EBI1 0>;
							interconnect-names = "cam_hf_0_mnoc";
						};
					};

					cam_mnoc_hf1: mnoc-hf1 {
						cell-index = <1>;
						node-name = "cam_hf_1_mnoc";
						bus-width-factor = <1>;
						traffic-merge-type = <CAM_CPAS_TRAFFIC_MERGE_SUM>;
						ib-bw-voting-needed;
						qcom,axi-port-mnoc {
							interconnects = <&mmss_noc MASTER_CAMNOC_HF1 0 &mc_virt SLAVE_EBI1 0>;
							interconnect-names = "cam_hf_1_mnoc";
						};
					};

					cam_mnoc_sf0: mnoc-sf0 {
						cell-index = <2>;
						node-name = "cam_sf_0_mnoc";
						bus-width-factor = <1>;
						traffic-merge-type = <CAM_CPAS_TRAFFIC_MERGE_SUM>;
						ib-bw-voting-needed;
						qcom,axi-port-mnoc {
							interconnects = <&mmss_noc MASTER_CAMNOC_SF 0 &mc_virt SLAVE_EBI1 0>;
							interconnect-names = "cam_sf_0_mnoc";
						};
					};
				};

				level-1 {
					level-index = <1>;

					ife0-wr {
						cell-index = <3>;
						node-name = "ife0_wr";
						client-name = "ife0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_WRITE>;
						parent-node = <&cam_mnoc_hf0>;
					};

					ife1-wr {
						cell-index = <4>;
						node-name = "ife1_wr";
						client-name = "ife1";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_WRITE>;
						parent-node = <&cam_mnoc_hf1>;
					};

					ife2-wr {
						cell-index = <5>;
						node-name = "ife2_wr";
						client-name = "ife2";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_WRITE>;
						parent-node = <&cam_mnoc_hf1>;
					};

					ipe0-rd {
						cell-index = <6>;
						node-name = "ipe0_rd";
						client-name = "ipe0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_READ>;
						parent-node = <&cam_mnoc_sf0>;
					};

					ipe0-wr {
						cell-index = <7>;
						node-name = "ipe0_wr";
						client-name = "ipe0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_WRITE>;
						parent-node = <&cam_mnoc_sf0>;
					};

					bps0-rd {
						cell-index = <8>;
						node-name = "bps0_rd";
						client-name = "bps0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_READ>;
						parent-node = <&cam_mnoc_sf0>;
					};

					bps0-wr {
						cell-index = <9>;
						node-name = "bps0_wr";
						client-name = "bps0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_WRITE>;
						parent-node = <&cam_mnoc_sf0>;
					};

					icp0-rd {
						cell-index = <10>;
						node-name = "icp0_rd";
						client-name = "icp0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_READ>;
						parent-node = <&cam_mnoc_sf0>;
					};

					jpeg-enc0-wr {
						cell-index = <11>;
						node-name = "jpeg_enc0_wr";
						client-name = "jpeg-enc0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_WRITE>;
						parent-node = <&cam_mnoc_sf0>;
					};

					jpeg-dma0-wr {
						cell-index = <12>;
						node-name = "jpeg_dma0_wr";
						client-name = "jpeg-dma0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_WRITE>;
						parent-node = <&cam_mnoc_sf0>;
					};

					lrme0-rd {
						cell-index = <13>;
						node-name = "lrme0_rd";
						client-name = "lrmecpas0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_READ>;
						parent-node = <&cam_mnoc_sf0>;
					};

					cpas-cdm0-rd {
						cell-index = <14>;
						node-name = "cpas_cdm0_rd";
						client-name = "cpas-cdm0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_READ>;
						parent-node = <&cam_mnoc_sf0>;
					};

					lrme0-wr {
						cell-index = <15>;
						node-name = "lrme0_wr";
						client-name = "lrmecpas0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_WRITE>;
						parent-node = <&cam_mnoc_sf0>;
					};

					icp0-wr {
						cell-index = <16>;
						node-name = "icp0_wr";
						client-name = "icp0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_WRITE>;
						parent-node = <&cam_mnoc_sf0>;
					};

					jpeg-enc0-rd {
						cell-index = <17>;
						node-name = "jpeg_enc0_rd";
						client-name = "jpeg-enc0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_READ>;
						parent-node = <&cam_mnoc_sf0>;
					};

					jpeg-dma0-rd {
						cell-index = <18>;
						node-name = "jpeg_dma0_rd";
						client-name = "jpeg-dma0";
						traffic-data = <CAM_CPAS_PATH_DATA_ALL>;
						traffic-transaction-type = <CAM_CPAS_TRANSACTION_READ>;
						parent-node = <&cam_mnoc_sf0>;
					};
				};
			};
		};

		qcom,cam-cdm-intf {
			compatible = "qcom,cam-cdm-intf";
			cell-index = <0>;
