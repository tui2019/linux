				hw-thd-dat = <22>;
				hw-thd-sta = <35>;
				hw-tbuf = <62>;
				hw-scl-stretch-en = <0>;
				hw-trdhld = <6>;
				hw-tsp = <3>;
				cci-clk-src = <37500000>;
				status = "okay";
