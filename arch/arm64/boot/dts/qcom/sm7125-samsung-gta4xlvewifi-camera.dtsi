			pinctrl-1 = <&cci2_suspend>;
			gpios = <&tlmm 27 0>,
				<&tlmm 28 0>;
			gpio-req-tbl-num = <0 1>;
			gpio-req-tbl-flags = <1 1>;
			gpio-req-tbl-label = "CCI_I2C_DATA2",
					     "CCI_I2C_CLK2";

			qcom,i2c_standard_mode {
				hw-thigh = <201>;
				hw-tlow = <174>;
				hw-tsu-sto = <204>;
				hw-tsu-sta = <231>;
				hw-thd-dat = <22>;
				hw-thd-sta = <162>;
				hw-tbuf = <227>;
				hw-scl-stretch-en = <0>;
				hw-trdhld = <6>;
				hw-tsp = <3>;
				cci-clk-src = <37500000>;
				status = "okay";
			};

			qcom,i2c_fast_mode {
				hw-thigh = <38>;
				hw-tlow = <56>;
				hw-tsu-sto = <40>;
				hw-tsu-sta = <40>;
				hw-thd-dat = <22>;
				hw-thd-sta = <35>;
				hw-tbuf = <62>;
				hw-scl-stretch-en = <0>;
				hw-trdhld = <6>;
				hw-tsp = <3>;
				cci-clk-src = <37500000>;
				status = "okay";
			};

			qcom,i2c_custom_mode {
				hw-thigh = <38>;
				hw-tlow = <56>;
				hw-tsu-sto = <40>;
				hw-tsu-sta = <40>;
				hw-thd-dat = <22>;
				hw-thd-sta = <35>;
				hw-tbuf = <62>;
				hw-scl-stretch-en = <1>;
				hw-trdhld = <6>;
				hw-tsp = <3>;
				cci-clk-src = <37500000>;
				status = "okay";
			};

			qcom,i2c_fast_plus_mode {
				hw-thigh = <16>;
				hw-tlow = <22>;
				hw-tsu-sto = <17>;
				hw-tsu-sta = <18>;
				hw-thd-dat = <16>;
				hw-thd-sta = <15>;
				hw-tbuf = <24>;
				hw-scl-stretch-en = <0>;
				hw-trdhld = <3>;
				hw-tsp = <3>;
				cci-clk-src = <37500000>;
				status = "okay";
			};
		};

